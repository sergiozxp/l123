[Unit]
Description=L123 experimental web terminal
After=docker.service network.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/ttyd -i 127.0.0.1 -p 8125 -W -O -m 4 -b /l123 -t fontSize=18 -t cursorBlink=true /opt/l123-web/run-session.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/l123-web
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
